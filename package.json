{
  "name": "rssfed",
  "private": true,
  "version": "0.1.0",
  "description": "RSS reader with ActivityPub support",
  "scripts": {
    "dev": "pnpm --filter @rssfed/server dev",
    "dev:nuxt": "pnpm --filter app dev",
    "dev:all": "pnpm --parallel -r run dev",
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "typecheck": "pnpm -r run typecheck",
    "db:generate": "pnpm --filter @rssfed/server generate",
    "db:push": "pnpm --filter @rssfed/server push"
  },
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "overrides": {
      "glob@<10.5.0": ">=10.5.0",
      "esbuild@<0.25.0": ">=0.25.0",
      "uuid@<11.1.1": ">=11.1.1"
    }
  }
}