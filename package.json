{
  "name": "rssfed",
  "private": true,
  "version": "0.1.0",
  "description": "RSS reader with ActivityPub support",
  "scripts": {
    "dev": "pnpm --filter @rssfed/hono-server dev",
    "dev:nuxt": "pnpm --filter @rssfed/nuxt-client dev",
    "dev:all": "pnpm --parallel -r run dev",
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "typecheck": "pnpm -r run typecheck",
    "db:push": "pnpm --filter @rssfed/hono-server push",
    "scripts:create-users": "pnpm --filter @rssfed/hono-server exec tsx scripts/create-test-users.ts",
    "scripts:test-redis": "pnpm --filter @rssfed/hono-server exec tsx scripts/test-redis.ts"
  },
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "playwright": "^1.63.0"
  }
}