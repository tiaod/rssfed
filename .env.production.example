# =============================================================================
# RSSFed 生产环境变量
#
# 用法：
#   cp .env.production.example .env.production
#   # 填好必填项（PUBLIC_URL 与 4 个密钥），再：
#   docker compose --env-file .env.production -f docker-compose.prod.yml up -d --build
#
# 本文件是唯一的环境变量来源：既提供 compose 变量插值，也通过 env_file 注入应用容器。
# 切勿提交 .env.production 到仓库。
# =============================================================================

# ── 对外地址（必填）─────────────────────────────────────────────────────────
# 公网可达、带协议、不带结尾斜杠。
# ActivityPub 的 actor ID 以此 origin 生成，上线后再改会导致已关注的远端实例失联。
# 本地试跑可临时用 http://localhost
PUBLIC_URL=

# ── 反向代理（可选）─────────────────────────────────────────────────────────
# 使用编排内置 Caddy（--profile tls）时的证书到期通知邮箱，不填则用示例值
# ACME_EMAIL=you@example.com

# ── 密钥（必填）─────────────────────────────────────────────────────────────
# 生成方式：openssl rand -hex 32（COUCHDB_PROXY_SECRET 用 openssl rand -hex 16 亦可）
POSTGRES_PASSWORD=
COUCHDB_PASSWORD=
# CouchDB 代理认证共享密钥：必须固定，每次重启都换会导致已登录客户端代理认证失效
COUCHDB_PROXY_SECRET=
# better-auth 会话签名密钥
BETTER_AUTH_SECRET=

# CouchDB 管理员用户名（默认 admin）
COUCHDB_USER=admin

# ── 管理员引导创建（可选）───────────────────────────────────────────────────
# 服务启动时检测，邮箱已存在则跳过，不会覆盖已有账号
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=ChangeMe123!
# ADMIN_NAME=管理员

# ── 依赖服务地址（可选）─────────────────────────────────────────────────────
# 默认指向 compose 内置的 postgres / couchdb / redis（容器网络内）。
# 改用云端托管服务时，取消注释并填托管实例地址。
# DATABASE_URL=postgresql://user:pass@pg.example.com:5432/rssfed
# COUCHDB_URL=https://couch.example.com
# REDIS_HOST=redis.example.com
# REDIS_PORT=6379

# ── 抓取与图片缓存（可选，下面是默认值）─────────────────────────────────────
# FETCH_INTERVAL=900000              # 抓取间隔 ms
# CHECK_INTERVAL=300000             # 轮询间隔 ms
# MAX_IMAGE_WIDTH=1200
# AVIF_QUALITY=45
# MAX_IMAGE_COUNT=5
# MAX_SOURCE_IMAGE_BYTES=8388608

# ── 自建 RSSHub（可选）──────────────────────────────────────────────────────
# 配置后，订阅里的 https://rsshub.app/... 会改写到该地址
# RSSHUB_BASE_URL=http://rsshub:1200

# ── 抓取代理（可选）─────────────────────────────────────────────────────────
# HTTP_PROXY=http://proxy.example.com:7890
# HTTPS_PROXY=http://proxy.example.com:7890
# NO_PROXY=localhost,127.0.0.1,.internal

# ── 对象存储（可选）：头像等附件的二进制存储 ────────────────────────────────
# 不配时上传类功能不可用，阅读与抓取不受影响
# STORAGE_S3_ENDPOINT=https://s3.example.com
# STORAGE_S3_REGION=auto
# STORAGE_S3_ACCESS_KEY_ID=
# STORAGE_S3_SECRET_ACCESS_KEY=
# STORAGE_S3_BUCKET=rssfed
# STORAGE_S3_FORCE_PATH_STYLE=true
# STORAGE_S3_PUBLIC_DOMAIN=https://cdn.example.com
# STORAGE_S3_PATH_PREFIX=

# ── 宿主端口绑定（可选）─────────────────────────────────────────────────────
# 默认只绑 127.0.0.1，供宿主上的 Nginx/Caddy 反代访问；公网不应直连这两个端口。
# 使用编排内置的 caddy（--profile tls）时无需改动。
# WEB_BIND=127.0.0.1
# WEB_PORT=3000
# SERVER_BIND=127.0.0.1
# SERVER_PORT=3001
