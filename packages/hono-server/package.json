{
  "name": "@rssfed/hono-server",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node --watch --import tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "push": "drizzle-kit push",
    "auth:generate": "auth generate --output src/db/auth-schema.ts --adapter drizzle --dialect pg -y"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1060.0",
    "@better-auth/drizzle-adapter": "^1.2.0",
    "@fedify/botkit": "^0.5.1",
    "@fedify/redis": "^2.2.3",
    "@hono/node-server": "^1.14.0",
    "better-auth": "^1.2.0",
    "bullmq": "^5.0.0",
    "drizzle-orm": "^0.45.1",
    "feedsmith": "^2.9.6",
    "hono": "^4.7.0",
    "http-proxy-agent": "^9.1.0",
    "https-proxy-agent": "^9.1.0",
    "ioredis": "^5.4.0",
    "nano": "^11.0.0",
    "nanoid": "^6.0.0",
    "postgres": "^3.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.9",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.1.0"
  }
}