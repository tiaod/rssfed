# Better Auth 配置
BETTER_AUTH_SECRET=change-me-to-a-random-string
BETTER_AUTH_URL=http://localhost:3001

# 管理员引导创建（可选）：服务启动时检测，邮箱已存在则跳过，不会覆盖已有账号
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=ChangeMe123!
# ADMIN_NAME=管理员

# 服务配置
PORT=3001
# 允许的跨域来源。两个变量都认，解析顺序是 CORS_ORIGINS → CORS_ORIGIN → 默认 localhost:3000，
# 所以只设下面这一行就够；多域名（如前后端分离 + 备用域名）时改用逗号分隔的 CORS_ORIGINS。
# 注意 NODE_ENV=production 时只认这份白名单，不再放行 localhost 和局域网网段——
# 生产环境忘了配会表现为「登录接口 200 但浏览器报 CORS」，而不是服务起不来。
CORS_ORIGIN=http://localhost:3000
# CORS_ORIGINS=http://localhost:3000,https://rss.example.com
BOTS_BASE_URL=http://localhost:3001
# 设为 production 后，CORS 与 Better Auth 的 trustedOrigins 都只认上面的显式白名单
# （开发模式下额外放通配符 * 和局域网网段，方便手机真机调试）。
# 本地开发留空或不设即可。
# 注意它**只管这一件事**，不影响 Cookie Secure 或日志详细程度。
# NODE_ENV=production

# PostgreSQL (Drizzle ORM)
DATABASE_URL=postgresql://rssfed:rssfed@localhost:5432/rssfed

# CouchDB
COUCHDB_URL=http://localhost:5984
COUCHDB_USER=admin
COUCHDB_PASSWORD=admin
# CouchDB Proxy Auth 共享密钥（需固定，启动时写入 CouchDB config）
COUCHDB_PROXY_SECRET=change-me-to-a-random-uuid

# Redis (BullMQ + BotKit KV Store / MessageQueue)
REDIS_HOST=localhost
REDIS_PORT=6379

# 抓取间隔 (ms)：调度器每隔这么久枚举所有 owner、把到期的源入队。
# 不要和下面的 CHECK_INTERVAL 搞混 —— 那个是 Bot 轮询产出库的节奏，不影响订阅抓取。
FETCH_INTERVAL=900000
# Bot 轮询产出间隔 (ms，默认 5 分钟)：BotKit 检查 Bot 产出库、把新条目投递到联邦。
# 只与 bots/index.ts 有关，改它不会让订阅抓得更勤。
CHECK_INTERVAL=300000
# 抓取并发度（默认 4）：源多、且直连常被墙导致单个源要等满 10s 超时时，串行会让队列追不上调度间隔
FETCH_CONCURRENCY=4

# 自适应抓取间隔（默认开）：按「距上次抓到新条目多久」自动拉长轮询，
#   15m → 30m → 1h → 3h → 6h；抓到新内容立刻回到基础间隔 FETCH_INTERVAL。
# 效果：内容安静的源省流量/请求，经常更新的源保持原来的节奏。
# 设为 0 恢复旧行为（每轮把全部 active 源都入队）。
# FETCH_ADAPTIVE=1
# 降频上限(ms)，默认 6 小时
# FETCH_MAX_INTERVAL=21600000
# 无验证器源（拿不到 ETag/Last-Modified，每轮只能整份下载）的降频档位整体提前一档：
#   1h 安静 → 30m、6h → 1h…；实测这类源占 345/705、贡献约 7,250 次全量下载/天。
# 设为 0 关闭（所有源用同一套档位）。
# FETCH_NO_VALIDATOR_SLOWDOWN=1
# 抓取缓存 TTL(ms，默认 10 分钟)：同一个 URL 在这个窗口内只真正发一次网络请求，
# 是「N 个 owner 订阅同一个源」省下 egress 的唯一手段。必须小于 FETCH_INTERVAL，
# 否则同一轮调度里同源会被重复抓。0 = 每次都发请求（等于关掉缓存）。
# FETCH_CACHE_TTL_MS=600000

# 抓取响应体大小上限（压缩态 / 解压后，字节）：正常源 gzip 后几 KB~几百 KB（705 源抽样最大 1.8MB），
# 几十 MB 只可能是异常源或压缩炸弹。单次抓取峰值内存 ≈ 2×压缩态 + 解压后，
# 默认 16MB/32MB 配合 FETCH_CONCURRENCY=4 的上界约 256MB；放宽时要同时下调 FETCH_CONCURRENCY。
# MAX_FEED_BYTES=16777216
# MAX_FEED_DECODED_BYTES=33554432

# 本地自建 RSSHub 基础地址（可选）。
# 配置后，抓取订阅中的 https://rsshub.app/... 会自动改写为该地址，其余 URL 不受影响。
# 留空则不做改写（走原始公共实例）。
# 注意：若同时配置了 RSS_FETCH_PROXY，本地 RSSHub 地址默认已在 RSS_FETCH_NO_PROXY 里绕过
# （localhost,127.0.0.1）；自定义该变量时记得保留本机地址。
# 另注：该地址会被自动登记为 SSRF 防护的可信端点（见 rss/ssrf-guard.ts）—— 抓取时的
# 「拒绝内网/保留地址」不会影响它，否则本地 RSSHub 上的源会全部失效。
# RSSHUB_BASE_URL=http://localhost:1200

# SSRF 防护总开关：设为 1 时放行所有内网/保留地址（仅供测试与本地自动化）。
# 生产不要开 —— 开了等于这一层防护不存在。默认关闭，即拒绝私网/环回/云元数据地址。
# SSRF_GUARD_ALLOW_PRIVATE=1

# 正文图片缓存（抓取时压缩为 AVIF 附件，供客户端离线展示）
# 压缩后最大宽度(px) / AVIF 质量(越低体积越小) / 每篇附件总体积上限(字节) / 每篇最多缓存张数 / 源图下载大小上限(字节)
# 这些是全局默认值，抓取时按它把正文图压成附件，一条条目只压一次；用户没有自己的图片参数。
# （原先「订阅源管理」里还有 per-feed 覆盖，那个页面随共享源库一起删掉了，现在只有这一份。）
# 压缩结果按「URL + 有效参数」内容寻址缓存在存储后端（`image-cache/` 前缀）：同一条 URL + 同一组参数只下载/编码一次，
# 正文里重复出现的模板图（如公众号文章内嵌的固定图）因此不必每个条目都重下一遍。
# 它只是抓取去重用的中间产物：老对象由内建清理任务按 IMAGE_CACHE_TTL_DAYS（默认 7 天）删除，
# 删掉最多是下次遇到同 URL 时重下一遍，不影响已入库条目的附件。
# 7 天是实测出来的拐点：重复出现的模板图间隔 99% 在 6.6 天内，再放宽 TTL 命中率只多 0.2pp
# 而稳态体积翻几倍（见 report/image-cache-usage）。
#
# 每篇默认最多缓存 6 张图：按正文顺序取前 N 张，超出的不再下载/缓存。
# 另有「每篇附件总体积上限」（默认 1MB）兜住大图：压缩后按正文顺序累计，超预算即停止
# 缓存后续图片，首图必留。
MAX_IMAGE_WIDTH=1200
AVIF_QUALITY=45
MAX_ENTRY_IMAGE_BYTES=1048576
MAX_IMAGE_COUNT=6
MAX_SOURCE_IMAGE_BYTES=8388608
# 图片缓存对象保留天数（<=0 关闭清理；默认 7）
# IMAGE_CACHE_TTL_DAYS=7

# 自适应保留条数（默认开启）：按 (owner × 源) 的活跃度每天重算「这个源在这个库里该留
# 多少条」，然后把该用户在**自己库**里这个源的那组条目裁到 N（10/20/30/50 四档，一次最多
# 变一档、带 20% 滞回）。也就是说它真的会删掉已抓取的旧条目，客户端也不再有。
# 设为 0 关闭，改为无条件保留（磁盘会持续增长）。注意它只裁剪，调大 N 不会把条目找回来。
# 每日跑一轮，启动后首次延迟 10 分钟。
# FEED_RETENTION_ADAPTIVE=1
# FEED_RETENTION_INITIAL_DELAY_MS=600000
# FEED_RETENTION_INTERVAL_MS=86400000
# 一轮最多处理多少个 owner（默认 200）：首次上线时防止一口气扫几千个库把 CouchDB 打满，
# 没轮到的下一轮继续。
# FEED_RETENTION_MAX_OWNERS=200

# 图片解码 / AVIF 压缩的**进程级**并发上限（默认按核数：2 核=1、4 核=2、8 核以上=4）。
# 这是内存峰值的总开关：实测 12MP PNG 连续压 12 张，进程峰值增量 1 张 +106MB、
# 2 张 +234MB、12 张 +451MB（见 src/images/concurrency.ts 的实测数据）。2G 的机器不要调大。
# IMAGE_CONCURRENCY=2
# 单张源图的像素上限（默认 4000 万）：更小的值会更早拒绝超大图，进一步压低单张峰值。
# MAX_INPUT_PIXELS=40000000
# 订阅源图标（侧边栏约 20px）压缩后的最大宽度，默认 64 —— 足够覆盖 3x 屏。
# 别照搬正文图片的 1200：实测 300 张 1200px AVIF 解码会阻塞主线程 1–5 秒。
# 改动此值需同步递增 FEED_ICON_CACHE_VERSION，否则已缓存的图标不会重新压缩。
# FEED_ICON_MAX_WIDTH=64

# 用户时间线（抓取按 owner 各自进行，直接写进各自的 user-timeline_<随机名> 库）
# 抓取节奏由上面的 FETCH_INTERVAL / FETCH_* 决定；这里只剩「手动同步这个请求最多等多久」。
# TIMELINE_REFRESH_WAIT_MS 客户端 POST /api/timeline/refresh?wait=1 的请求内等待上限(ms，超时返回 completed:false 转后台)
TIMELINE_REFRESH_WAIT_MS=15000

# 休眠用户暂停抓取：超过 N 天没有调用过时间线接口的账号停止抓取，省下 egress 与写库。
# 下次打开应用时自动恢复 —— 不需要任何重建，下一轮调度照常抓，缺的内容随那次抓取补上。
# 0 = 关闭该策略。
# TIMELINE_DORMANT_DAYS=90
# TIMELINE_DORMANT_SCAN_INTERVAL_MS=86400000

# 抓取代理（可选）：订阅被墙站点（如 v2ex.com、news.ycombinator.com）时需配置。
# 只影响订阅抓取与图片缓存，用的是下面的专用变量——
# 不要改用 HTTP_PROXY/HTTPS_PROXY：那是进程级变量，axios(nano→CouchDB)、AWS SDK、undici
# 都会自动认，会把 CouchDB / S3 / ActivityPub 的请求也拖进代理。
# RSS_FETCH_PROXY=http://127.0.0.1:7890
# 无需走代理的域名（逗号分隔，支持 .example.com / host）；不设则默认绕过 localhost,127.0.0.1,::1
# RSS_FETCH_NO_PROXY=localhost,127.0.0.1,.internal
# 先试哪条链路（proxy 默认 | direct）。代理按流量计费/有额度时建议设 direct：
# 能直连的源不再经过代理；直连网络级失败（超时/被重置）的域名会被记住并自动改走代理。
# RSS_FETCH_PREFER=direct
# 路由记忆 TTL(ms)：某域名最近走通的链路在此时长内优先复用（默认 1800000 = 30 分钟）
# RSS_FETCH_ROUTE_TTL=1800000

# 上传文件（头像、图标等）的存储后端：s3（默认）| fs
# 正文图片不走这里——它们作为 CouchDB 附件存在各自的用户库里，见上面「正文图片缓存」。
# 选 fs 时必须设 STORAGE_FS_DIR，否则启动直接抛错；取值写错也会抛错，
# 而不是静默退化成另一个后端（避免把文件写进不想写的地方）。
# 单机自托管且不想额外跑对象存储时，fs 是最省事的选择。
STORAGE_DRIVER=s3
# STORAGE_FS_DIR=/data/uploads
# 公开访问域名（可选）：配置后附件 URL 直接指向该域名；留空则经本服务 /api/files/* 代理读取
# STORAGE_FS_PUBLIC_DOMAIN=https://cdn.example.com

# S3 兼容对象存储：头像等上传文件的二进制存储。
# 本地 dev 由 docker-compose.yml 的 seaweedfs 服务提供，S3 API 监听 8333；
# 凭据写在 packages/hono-server/seaweedfs-s3.json（dev 专用，生产请换成正式对象存储）。
STORAGE_S3_ENDPOINT=http://localhost:8333
STORAGE_S3_REGION=us-east-1
STORAGE_S3_ACCESS_KEY_ID=rssfed-dev
STORAGE_S3_SECRET_ACCESS_KEY=rssfed-dev-secret
STORAGE_S3_BUCKET=rssfed
STORAGE_S3_FORCE_PATH_STYLE=true
# 公开访问域名（可选）：配置后附件 URL 直接指向该域名（可挂 CDN）；
# 留空时附件经本服务的 /api/files/* 代理读取，默认开箱即用
# STORAGE_S3_PUBLIC_DOMAIN=https://cdn.example.com
# 对象 key 前缀（可选）：多环境共用同一桶时用于隔离
# STORAGE_S3_PATH_PREFIX=
