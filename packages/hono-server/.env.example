# Better Auth 配置
BETTER_AUTH_SECRET=change-me-to-a-random-string
BETTER_AUTH_URL=http://localhost:3001

# 管理员引导创建（可选）：服务启动时检测，邮箱已存在则跳过，不会覆盖已有账号
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=ChangeMe123!
# ADMIN_NAME=管理员

# 服务配置
PORT=3001
CORS_ORIGIN=http://localhost:3000
BOTS_BASE_URL=http://localhost:3001

# PostgreSQL (Drizzle ORM)
DATABASE_URL=postgresql://rssfed:rssfed@localhost:5432/rssfed

# CouchDB
COUCHDB_URL=http://localhost:5984
COUCHDB_USER=admin
COUCHDB_PASSWORD=admin
# CouchDB Proxy Auth 共享密钥（需固定，启动时写入 CouchDB config）
COUCHDB_PROXY_SECRET=change-me-to-a-random-uuid

# Redis (BullMQ + BotKit KV Store / MessageQueue)
REDIS_HOST=localhost
REDIS_PORT=6379

# 抓取间隔 (ms)
FETCH_INTERVAL=900000
CHECK_INTERVAL=300000
# 抓取并发度（默认 4）：源多、且直连常被墙导致单个源要等满 10s 超时时，串行会让队列追不上调度间隔
FETCH_CONCURRENCY=4

# 自适应抓取间隔（默认开）：按「距上次抓到新条目多久」自动拉长轮询，
#   15m → 30m → 1h → 3h → 6h；抓到新内容立刻回到基础间隔 FETCH_INTERVAL。
# 效果：内容安静的源省流量/请求，经常更新的源保持原来的节奏。
# 设为 0 恢复旧行为（每轮把全部 active 源都入队）。
# FETCH_ADAPTIVE=1
# 降频上限(ms)，默认 6 小时
# FETCH_MAX_INTERVAL=21600000
# 无验证器源（拿不到 ETag/Last-Modified，每轮只能整份下载）的降频档位整体提前一档：
#   1h 安静 → 30m、6h → 1h…；实测这类源占 345/705、贡献约 7,250 次全量下载/天。
# 设为 0 关闭（所有源用同一套档位）。
# FETCH_NO_VALIDATOR_SLOWDOWN=1
# 抓取响应体大小上限（压缩态 / 解压后，字节）：正常源 gzip 后几十 KB，异常源不应把 worker 内存顶爆。
# MAX_FEED_BYTES=33554432
# MAX_FEED_DECODED_BYTES=67108864
# Bot 产出复制队列并发（默认 2）：新条目镜像进相关 Bot 库，失败自动重试
# BOT_COPY_CONCURRENCY=2

# 本地自建 RSSHub 基础地址（可选）。
# 配置后，抓取订阅中的 https://rsshub.app/... 会自动改写为该地址，其余 URL 不受影响。
# 留空则不做改写（走原始公共实例）。
# 注意：若同时配置了 RSS_FETCH_PROXY，本地 RSSHub 地址默认已在 RSS_FETCH_NO_PROXY 里绕过
# （localhost,127.0.0.1）；自定义该变量时记得保留本机地址。
# RSSHUB_BASE_URL=http://localhost:1200

# 正文图片缓存（抓取时压缩为 AVIF 附件，供客户端离线展示）
# 压缩后最大宽度(px) / AVIF 质量(越低体积越小) / 每篇附件总体积上限(字节) / 每篇最多尝试张数 / 源图下载大小上限(字节)
# 这些是「全局默认值」，管理员可在「订阅源管理」里按源覆盖（如漫画源开启「缓存全部图片」）：
# per-feed 配置（maxEntryImageBytes/maxImageCount/maxImageWidth/avifQuality/maxSourceImageBytes）未设置时回退到这里。
# 聚合路径只搬运源库附件，不再按用户参数重压。
# 压缩结果按「URL + 有效参数」内容寻址缓存在存储后端（`image-cache/` 前缀）：同一条 URL + 同一组参数只下载/编码一次，
# 正文里重复出现的模板图（如公众号文章内嵌的固定图）因此不必每个条目都重下一遍。
# 它只是抓取去重用的中间产物：老对象由内建清理任务按 IMAGE_CACHE_TTL_DAYS（默认 30 天）删除，
# 删掉最多是下次遇到同 URL 时重下一遍，不影响已入库条目的附件。
#
# 主约束是「每篇附件总体积上限」：压缩后按正文顺序累计，超预算即停止缓存后续图片，
# 首图必留 —— 小图（实测 p50 约 19KB）能存几十张，大图自然少存。
# 实测 1MB 可覆盖 93.4% 的正文图（固定 5 张只有 48.1%，见 report/image-cache-diagnosis）。
# MAX_IMAGE_COUNT 已退化为「请求数硬顶」：预算要压完才知道大小，靠它兜住异常多图的源。
MAX_IMAGE_WIDTH=1200
AVIF_QUALITY=45
MAX_ENTRY_IMAGE_BYTES=1048576
MAX_IMAGE_COUNT=200
MAX_SOURCE_IMAGE_BYTES=8388608
# 图片缓存对象保留天数（<=0 关闭清理；默认 30）
# IMAGE_CACHE_TTL_DAYS=30

# 用户时间线聚合（服务端把每个用户订阅的条目聚合进 user-timeline_<随机名> 派生库）
# TIMELINE_INTERVAL 定时入队间隔(ms)；TIMELINE_NOTIFY_INTERVAL 抓取到新条目后的通知节流(ms)；
# TIMELINE_RECONCILE_COOLDOWN 同一用户两轮聚合之间的最小间隔(ms，0=关闭；窗口内的通知会排到冷却结束而不是丢弃)；
# TIMELINE_REFRESH_WAIT_MS 客户端 POST /api/timeline/refresh?wait=1 的请求内等待上限(ms，超时返回 completed:false 转后台)
TIMELINE_INTERVAL=300000
TIMELINE_NOTIFY_INTERVAL=30000
TIMELINE_RECONCILE_COOLDOWN=300000
TIMELINE_REFRESH_WAIT_MS=15000

# 抓取代理（可选）：订阅被墙站点（如 v2ex.com、news.ycombinator.com）时需配置。
# 只影响订阅抓取与图片缓存，用的是下面的专用变量——
# 不要改用 HTTP_PROXY/HTTPS_PROXY：那是进程级变量，axios(nano→CouchDB)、AWS SDK、undici
# 都会自动认，会把 CouchDB / S3 / ActivityPub 的请求也拖进代理。
# RSS_FETCH_PROXY=http://127.0.0.1:7890
# 无需走代理的域名（逗号分隔，支持 .example.com / host）；不设则默认绕过 localhost,127.0.0.1,::1
# RSS_FETCH_NO_PROXY=localhost,127.0.0.1,.internal
# 先试哪条链路（proxy 默认 | direct）。代理按流量计费/有额度时建议设 direct：
# 能直连的源不再经过代理；直连网络级失败（超时/被重置）的域名会被记住并自动改走代理。
# RSS_FETCH_PREFER=direct
# 路由记忆 TTL(ms)：某域名最近走通的链路在此时长内优先复用（默认 1800000 = 30 分钟）
# RSS_FETCH_ROUTE_TTL=1800000

# S3 兼容对象存储：头像等上传文件的二进制存储。
# 本地 dev 由 docker-compose.yml 的 seaweedfs 服务提供，S3 API 监听 8333；
# 凭据写在 packages/hono-server/seaweedfs-s3.json（dev 专用，生产请换成正式对象存储）。
STORAGE_S3_ENDPOINT=http://localhost:8333
STORAGE_S3_REGION=us-east-1
STORAGE_S3_ACCESS_KEY_ID=rssfed-dev
STORAGE_S3_SECRET_ACCESS_KEY=rssfed-dev-secret
STORAGE_S3_BUCKET=rssfed
STORAGE_S3_FORCE_PATH_STYLE=true
# 公开访问域名（可选）：配置后附件 URL 直接指向该域名（可挂 CDN）；
# 留空时附件经本服务的 /api/files/* 代理读取，默认开箱即用
# STORAGE_S3_PUBLIC_DOMAIN=https://cdn.example.com
# 对象 key 前缀（可选）：多环境共用同一桶时用于隔离
# STORAGE_S3_PATH_PREFIX=
