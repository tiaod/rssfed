# Better Auth 配置
BETTER_AUTH_SECRET=change-me-to-a-random-string
BETTER_AUTH_URL=http://localhost:3001

# 管理员引导创建（可选）：服务启动时检测，邮箱已存在则跳过，不会覆盖已有账号
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=ChangeMe123!
# ADMIN_NAME=管理员

# 服务配置
PORT=3001
CORS_ORIGIN=http://localhost:3000
BOTS_BASE_URL=http://localhost:3001

# PostgreSQL (Drizzle ORM)
DATABASE_URL=postgresql://rssfed:rssfed@localhost:5432/rssfed

# CouchDB
COUCHDB_URL=http://localhost:5984
COUCHDB_USER=admin
COUCHDB_PASSWORD=admin
# CouchDB Proxy Auth 共享密钥（需固定，启动时写入 CouchDB config）
COUCHDB_PROXY_SECRET=change-me-to-a-random-uuid

# Redis (BullMQ + BotKit KV Store / MessageQueue)
REDIS_HOST=localhost
REDIS_PORT=6379

# 抓取间隔 (ms)
FETCH_INTERVAL=900000
CHECK_INTERVAL=300000

# 本地自建 RSSHub 基础地址（可选）。
# 配置后，抓取订阅中的 https://rsshub.app/... 会自动改写为该地址，其余 URL 不受影响。
# 留空则不做改写（走原始公共实例）。
# 注意：若同时配置了 HTTP(S)_PROXY，需把本地 RSSHub 地址加入 NO_PROXY（如 localhost），
# 否则 localhost 请求会被错误地走代理。
# RSSHUB_BASE_URL=http://localhost:1200

# 正文图片缓存（抓取时压缩为 AVIF 附件，供客户端离线展示）
# 压缩后最大宽度(px) / AVIF 质量(越低体积越小) / 每篇最多缓存张数 / 源图下载大小上限(字节)
# 这些是「全局默认值」。管理员可在「订阅源管理」里按源覆盖（如漫画源开启「缓存全部图片」），
# per-feed 配置（maxImageCount/maxImageWidth/avifQuality/maxSourceImageBytes）未设置时回退到这里。
MAX_IMAGE_WIDTH=1200
AVIF_QUALITY=45
MAX_IMAGE_COUNT=5
MAX_SOURCE_IMAGE_BYTES=8388608

# 抓取代理（可选）：订阅被墙站点（如 v2ex.com）时需配置
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
# 无需走代理的域名（逗号分隔，支持 .example.com / host）
# NO_PROXY=localhost,127.0.0.1,.internal

# S3 兼容对象存储（可选）：头像等上传文件的二进制存储
STORAGE_S3_ENDPOINT=http://localhost:3900
STORAGE_S3_REGION=garage
STORAGE_S3_ACCESS_KEY_ID=your-access-key-id
STORAGE_S3_SECRET_ACCESS_KEY=your-secret-access-key
STORAGE_S3_BUCKET=rssfed
STORAGE_S3_FORCE_PATH_STYLE=true
# 公开访问域名（可选）：配置后附件 URL 直接指向该域名（可挂 CDN）；
# 留空时附件经本服务的 /api/files/* 代理读取，默认开箱即用
# STORAGE_S3_PUBLIC_DOMAIN=https://cdn.example.com
# 对象 key 前缀（可选）：多环境共用同一桶时用于隔离
# STORAGE_S3_PATH_PREFIX=
